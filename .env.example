# ───────── Browser (safe to expose — protected by Row Level Security) ─────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
# Set to "true" ONLY for a backend-less visual preview of the guest flow (sample data, clearly marked).
VITE_DEMO_PREVIEW=false

# ───────── Server only (Netlify environment variables — NEVER prefix with VITE_) ─────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Long random string (>= 32 chars). Used to HMAC guest QR tokens / private codes. Changing it invalidates all issued credentials.
CREDENTIAL_PEPPER=GENERATE_WITH_openssl_rand_-hex_32
# Used to HMAC IP addresses before rate-limit storage.
RATE_LIMIT_SALT=GENERATE_WITH_openssl_rand_-hex_16
JOTFORM_API_KEY=YOUR_JOTFORM_API_KEY
# Use https://eu-api.jotform.com for EU accounts.
JOTFORM_API_BASE=https://api.jotform.com
JOTFORM_FORM_ID=261778660839070
# Public site origin used inside personal QR links, e.g. https://concierge.example.com
PUBLIC_SITE_URL=https://YOUR-SITE.netlify.app
# Optional: extra hosts allowed for book covers / headshots (comma separated)
ALLOWED_IMAGE_HOSTS=
