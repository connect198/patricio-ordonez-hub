{
  "name": "kingdom-concierge",
  "version": "1.0.0",
  "private": true,
  "description": "Kingdom Concierge — the royal guest experience platform for Kingdom events.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "zip": "bash scripts/make-zip.sh",
    "check:functions": "esbuild netlify/functions/*.ts --bundle --platform=node --format=esm --outdir=.netlify-check --log-level=warning && rm -rf .netlify-check",
    "check": "npm run typecheck && npm test && npm run check:functions && vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "jsqr": "^1.4.0",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
